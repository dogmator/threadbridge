#!/bin/sh
set -eu

echo "Running pre-commit checks in Docker..."

suffix="$$"
image="threadbridge-precommit:${suffix}"
network="threadbridge-precommit-${suffix}"
postgres="threadbridge-precommit-postgres-${suffix}"

cleanup() {
  docker rm -f "$postgres" >/dev/null 2>&1 || true
  docker network rm "$network" >/dev/null 2>&1 || true
  docker image rm "$image" >/dev/null 2>&1 || true
}

trap cleanup EXIT HUP INT TERM

docker build --load -t "$image" .
docker network create "$network" >/dev/null

docker run -d \
  --name "$postgres" \
  --network "$network" \
  -e POSTGRES_DB=threadbridge \
  -e POSTGRES_USER=threadbridge \
  -e POSTGRES_PASSWORD=threadbridge \
  postgres:18-alpine >/dev/null

attempt=0
until docker exec "$postgres" \
  pg_isready -U threadbridge -d threadbridge >/dev/null 2>&1
do
  attempt=$((attempt + 1))

  if [ "$attempt" -ge 30 ]; then
    echo "PostgreSQL did not become ready." >&2
    docker logs "$postgres" >&2 || true
    exit 1
  fi

  sleep 1
done

docker run --rm \
  --network "$network" \
  -e DATABASE_URL="postgresql://threadbridge:threadbridge@${postgres}:5432/threadbridge" \
  --entrypoint npm \
  "$image" \
  run check
